pkgname=mongles-da-noite
pkgver=0.1.0
pkgrel=22
pkgdesc='Pixel-art survival roguelite set in a night of monsters'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-multimedia' 'qt6-wayland' 'sdl2')
makedepends=('gcc' 'make' 'qt6-base' 'qt6-declarative' 'qt6-multimedia' 'sdl2')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/mongles-da-noite "$pkgdir/usr/bin/mongles-da-noite"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/mongles-da-noite.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/mongles-da-noite.svg"
  install -Dm644 "$startdir/mongles-da-noite.desktop" "$pkgdir/usr/share/applications/mongles-da-noite.desktop"
}
